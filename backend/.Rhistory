# Small dataset
X <- c(1, 2, 3, 4, 5)  # Independent variable
Y <- c(2, 4, 5, 4, 5)  # Dependent variable
# Create a data frame
data <- data.frame(X, Y)
View(data)
# Fit a linear regression model
model <- lm(Y ~ X, data = data)
# Print the summary of the model
summary(model)
# Make predictions
Y_pred <- predict(model, newdata = data)
# Plot the data and the regression line
plot(X, Y, main = 'Simple Linear Regression Example', xlab = 'Independent Variable (X)', ylab = 'Dependent Variable (Y)')
abline(model, col = 'red')
# Print the coefficients
cat('Intercept (b0):', coef(model)[1], '\n')
cat('Slope (b1):', coef(model)[2], '\n')
# Plot the data and the regression line
plot(X, Y, main = 'Linear Regression Example', xlab = 'Independent Variable (X)', ylab = 'Dependent Variable (Y)')
abline(model, col = 'red')
View(model)
View(model)
# Make predictions
Y_pred <- predict(model, newdata = data)
Y_pred
newdata
